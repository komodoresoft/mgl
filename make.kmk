CC = gcc
AR = ar
INCLUDE = -Iinclude
LIBS = -Llib -lglfw3dll -lopengl32 -lgdi32 -lmgl -lm

task init
	cmd mkdir build
	cmd mkdir lib

task build_mgl
	cmd $(CC) -o build\MGL.o -c src\MGL.c $(INCLUDE)
	cmd $(CC) -o build\mat4x4.o -c src\mat4x4.c $(INCLUDE)
	cmd $(CC) -o build\transform.o -c src\transform.c $(INCLUDE)
	cmd $(CC) -o build\displaylist.o -c src\displaylist.c $(INCLUDE)
	cmd $(CC) -o build\mglu.o -c src\mglu.c $(INCLUDE)
	cmd $(CC) -o build\glad.o -c src\glad.c $(INCLUDE)
	cmd $(AR) rcs lib\libmgl.a build\MGL.o build\mat4x4.o build\displaylist.o build\transform.o build\mglu.o build\glad.o

task build_tests
	cmd $(CC) -o examples/lookat examples/lookat.c $(INCLUDE) $(LIBS)
	cmd $(CC) -o examples/tris examples/tris.c $(INCLUDE) $(LIBS)
	cmd $(CC) -o examples/cube examples/cube.c $(INCLUDE) $(LIBS)
