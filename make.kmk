INCLUDE = -Iinclude
LIBS = -Llib -lglfw3dll -lopengl32 -lgdi32 -lmgl -lm

task build_mgl
	cmd gcc -o build\MGL.o -c src\MGL.c $(INCLUDE)
	cmd gcc -o build\mat4x4.o -c src\mat4x4.c $(INCLUDE)
	cmd gcc -o build\transform.o -c src\transform.c $(INCLUDE)
	cmd gcc -o build\displaylist.o -c src\displaylist.c $(INCLUDE)
	cmd gcc -o build\mglu.o -c src\mglu.c $(INCLUDE)
	cmd gcc -o build\glad.o -c src\glad.c $(INCLUDE)
	cmd ar rcs lib\libmgl.a build\MGL.o build\mat4x4.o build\displaylist.o build\transform.o build\mglu.o build\glad.o

task build_tests
	cmd gcc -o examples/lookat examples/lookat.c $(INCLUDE) $(LIBS)
	cmd gcc -o examples/tris examples/tris.c $(INCLUDE) $(LIBS)
